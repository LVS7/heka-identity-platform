# --- LLM (agent) ---
# Optional. Without it the agent produces the same reconciliation report deterministically.
OPENAI_API_KEY=your_api_key_here

# --- Heka Identity Service ---
IDENTITY_SERVICE_URL=http://localhost:3000
# Demo token with extremely long validity (matches default JWT_SECRET=test of a local Identity Service instance)
IDENTITY_SERVICE_ACCESS_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlcyI6WyJBZG1pbiJdLCJuYW1lIjoiZGVtbyIsInR5cGUiOiJhY2Nlc3MiLCJpYXQiOjE3NzE5ODA5MjAsImV4cCI6MzI4NzU5ODA5MjAsImF1ZCI6Ikhla2EgSWRlbnRpdHkgU2VydmljZSIsImlzcyI6Ikhla2EiLCJzdWIiOiI1YjQwZDIwMi0yMmI2LTQ2ZDMtOWY0NC04YmY3ZjEwYzNmNGUifQ.j8v7QFYkpwgtPbDU-aIMayMsMo_vLQ9v9h3dBELqBeo

# --- Wallet (operator's Heka Wallet public DID, see README) ---
# Optional: only needed for DIDComm wallet invocation. The UI's "Simulate presentation"
# and OID4VP deep links work without it.
HOLDER_PUBLIC_DID=

# --- Hedera (did:hedera resolution) ---
# Defaults match the development operator committed in Heka Identity Service, so a local
# instance works out of the box. Replace with your own testnet account for anything real.
HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ID=0.0.5489553
HEDERA_OPERATOR_KEY=302e020100300506032b6570042204209f54b75b6238ced43e41b1463999cb40bf2f7dd2c9fd4fd3ef780027c016a138

# --- ARD registry (mcp-gateway-registry) ---
# Not required: discovery reads the publishers directly. See spec/ADR-002.
REGISTRY_URL=http://localhost

# --- Ports ---
TRUST_LENS_WEB_PORT=4000
ACME_AGENT_PORT=10003
TRUSTCO_CONSOLE_PORT=4100
AS_PORT=4300
MCP_PORT=4400
ARD_ADAPTER_PORT=4200
# Keep 443: the catalogs and cards written by `yarn seed` carry no port in their URLs,
# so anything else makes the digest-bound card fetch miss.
SITES_PORT=443

# --- Public URLs ---
# Only needed when a service is not reachable at localhost — under Docker each one must
# advertise its container address. The A2A client connects to the URL *inside* the agent
# card, so ACME_AGENT_PUBLIC_URL is what actually decides reachability.
# ACME_AGENT_PUBLIC_URL=http://trustlens-agent:10003/
# ACME_AGENT_URL=http://trustlens-agent:10003
# AS_PUBLIC_URL=http://trustlens-as:4300
# MCP_PUBLIC_URL=http://trustlens-mcp:4400

# --- Publisher domains (self-signed TLS, generated on first run) ---
ACME_DOMAIN=acme-invoices.example
PRO_DOMAIN=acme-invoices-ai.example

# --- Timeouts and debugging ---
# How long the agent waits for a presentation before failing the task.
AGENT_AUTH_TIMEOUT_MS=180000
# Access token lifetime minted by the authorization server, in seconds.
AS_TOKEN_TTL=300
# Set to 1 for Credo debug logging, or for seed stack traces.
CREDO_LOG_DEBUG=0
SEED_DEBUG=0
